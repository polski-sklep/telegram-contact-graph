# =============================================================================
# Telegram Contact Graph — environment variables
# Copy to .env and fill in. .env is in .gitignore.
# =============================================================================

# --- Telegram API credentials ------------------------------------------------
# Obtain at https://my.telegram.org/auth → API development tools.
# These authenticate Telethon as YOUR account (not as a bot). The first run
# will prompt for the SMS code Telegram sends to your registered phone number,
# then save a *.session file containing a bearer credential.
#
# Treat *.session files like a password — they grant full read access to your
# Telegram account. They are .gitignore'd by default.
TG_API_ID=
TG_API_HASH=
